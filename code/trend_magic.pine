// Logic is mirrored 1:1 by tm_core.py (mode="fixed").
//@version=6
indicator("Trend Magic Enhanced v6", shorttitle = "TMAG v6", overlay = true, format = format.price, precision = 2)

// ───────────────────────────────── Inputs
const string GM = "Main Settings"
const string GA = "Appearance"

int    cciLen   = input.int(20, "CCI Period", minval = 2, group = GM, tooltip = "Period for the Commodity Channel Index")
int    atrLen   = input.int(5, "ATR Period", minval = 1, group = GM)
float  atrMult  = input.float(2.0, "ATR Multiplier", minval = 0.1, step = 0.1, group = GM)
string atrType  = input.string("SMA(TR)", "ATR Type", options = ["SMA(TR)", "RMA(TR)"], group = GM, tooltip = "SMA(TR) = original behaviour. RMA(TR) = Wilder ATR.")
float  cciSrc   = input.source(close, "CCI Source", group = GM)
string flipOn   = input.string("Wick", "Flip Trigger", options = ["Wick", "Close"], group = GM, tooltip = "Wick = original (low crosses above / high crosses below the line). Close = price close crosses the line; less noisy.")
bool   smoothOn = input.bool(false, "Smooth Trigger Line", group = GM, tooltip = "Smooths the line used for flip detection and plotting. The ratchet state itself is never smoothed.")
int    smoothLen = input.int(14, "Smoothing Length", minval = 1, group = GM)
string maType   = input.string("SMA", "MA Smoothing Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = GM)
color  bullColor = input.color(#00ffbb, "Bullish Color", group = GA)
color  bearColor = input.color(#ff1100, "Bearish Color", group = GA)

// ───────────────────────────────── ATR (computed every bar, selected afterwards)
float trueRange = ta.tr(true)
float atrSma    = ta.sma(trueRange, atrLen)
float atrRma    = ta.rma(trueRange, atrLen)
float atrVal    = atrType == "SMA(TR)" ? atrSma : atrRma

// ───────────────────────────────── CCI regime (na on a flat window -> regime simply holds)
float cciVal = ta.cci(cciSrc, cciLen)
var bool isUp = true
if not na(cciVal)
    isUp := cciVal >= 0

// ───────────────────────────────── Ratchet state (raw; seeded on first valid bar, never zero-seeded)
float stopUp   = low  - atrVal * atrMult
float stopDown = high + atrVal * atrMult

var float rawLine = na
if not na(rawLine)
    if not na(atrVal)
        rawLine := isUp ? math.max(rawLine, stopUp) : math.min(rawLine, stopDown)
else if not na(atrVal) and not na(cciVal)
    rawLine := isUp ? stopUp : stopDown

// ───────────────────────────────── Optional smoothing of the TRIGGER line only
float maSma  = ta.sma(rawLine, smoothLen)
float maEma  = ta.ema(rawLine, smoothLen)
float maRma  = ta.rma(rawLine, smoothLen)
float maWma  = ta.wma(rawLine, smoothLen)
float maVwma = ta.vwma(rawLine, smoothLen)
float maSel = switch maType
    "SMA"        => maSma
    "EMA"        => maEma
    "SMMA (RMA)" => maRma
    "WMA"        => maWma
    "VWMA"       => maVwma
    => maSma
float tmLine = smoothOn ? maSel : rawLine

// ───────────────────────────────── Direction state machine
float trigLo = flipOn == "Wick" ? low  : close
float trigHi = flipOn == "Wick" ? high : close
bool  crossUp   = ta.crossover(trigLo, tmLine)
bool  crossDown = ta.crossunder(trigHi, tmLine)
bool  firstLine = not na(tmLine) and na(tmLine[1])

var int trendDir = 0
if firstLine
    trendDir := close > tmLine ? 1 : close < tmLine ? -1 : 0
else if crossUp
    trendDir := 1
else if crossDown
    trendDir := -1

// Signals fire only on a CLOSED bar (the flip uses that bar's low/high/close).
bool bullSig = trendDir == 1  and trendDir[1] == -1 and barstate.isconfirmed
bool bearSig = trendDir == -1 and trendDir[1] == 1  and barstate.isconfirmed

// ───────────────────────────────── Plots
color regimeColor = trendDir > 0 ? bullColor : trendDir < 0 ? bearColor : color.gray
pLine = plot(tmLine, "Trend Magic", color.new(regimeColor, 30), 3)
pMid  = plot((open + close) / 2, "Mid", display = display.none)
fill(pLine, pMid, color.new(regimeColor, 90))

plotshape(bullSig, "Bullish Trend", shape.labelup,   location.belowbar, bullColor, text = "▲", textcolor = chart.fg_color, size = size.small)
plotshape(bearSig, "Bearish Trend", shape.labeldown, location.abovebar, bearColor, text = "▼", textcolor = chart.fg_color, size = size.small)

// Set alert frequency to "Once Per Bar Close".
alertcondition(bullSig, "Bullish Trend", "Bullish Trend Detected")
alertcondition(bearSig, "Bearish Trend", "Bearish Trend Detected")
alertcondition(bullSig or bearSig, "Trend Shift", "Trend Shift Detected")
